# ABDO push folder — selective access.
#
# OneSignal MUST be able to fetch push/onesignal/OneSignalSDKWorker.js from the browser,
# so a blanket deny here silently kills web push (that is exactly what an earlier version of
# this file did). Blocking is therefore scoped to what must not be read:
#   - .php executed or downloaded directly by a visitor (cron uses an authenticated URL instead)
#   - the queue, which holds user notification copy
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Allow from all
</IfModule>

<FilesMatch "\.(php|phar|ini|log|json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

RedirectMatch 403 ^/push/queue(/|$)
# Both rules below block .php; keep the RedirectMatch, but when we turn the sender on you must
# delete the <FilesMatch> deny for push-sync.php only, otherwise the client's schedule POST gets
# a 403 from Apache and no reminder is ever queued - silently. The endpoint is safe to expose:
# it requires a per-device HMAC token and refuses everything else.
#   allow:  <Files push-sync.php> Require all granted </Files>
RedirectMatch 403 ^/push/.*\.php$

# push-sync.php is the one .php a browser must be able to POST to. Safe to expose: it takes no
# input it trusts (per-uid derived token, strict uid regex, past events dropped, hard event cap)
# and returns only {ok, queued}. push-cron.php and every source file stay blocked.
<Files "push-sync.php">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
  </IfModule>
</Files>
Options -Indexes
